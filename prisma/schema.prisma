generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum Role {
  ADMIN
  USER
}

enum StatusPagamento {
  PAGO
  PENDENTE
  PARCIAL
}

enum TipoTransacao {
  ENTRADA
  SAIDA
}

//////////////////////////////////////////////////
// COMPRAS
//////////////////////////////////////////////////

enum ModeloCaminhao {
  TRUCK
  BITRUCK
  CARRETA
}

enum TipoDescontoCompra {
  AUTOMATICO_MODELO
  PERCENTUAL
  MANUAL_KG
}

enum StatusCompra {
  ABERTA
  FECHADA
  CANCELADA
}

//////////////////////////////////////////////////
// VENDAS / ROMANEIO
//////////////////////////////////////////////////

enum TipoFreteVenda {
  CIF
  FOB
}

enum StatusVenda {
  ABERTA
  FATURADA
  CANCELADA
  ENTREGUE
}

//////////////////////////////////////////////////
// CLIENTES
//////////////////////////////////////////////////

enum TipoCliente {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

//////////////////////////////////////////////////
// USER
//////////////////////////////////////////////////

model User {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // DADOS
  //////////////////////////////////////////////////

  nome String

  sobrenome String

  email String @unique

  senha String

  telefone String?

  endereco String?

  //////////////////////////////////////////////////
  // PERMISSÃO
  //////////////////////////////////////////////////

  role Role @default(ADMIN)

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([email])
  @@index([role])
  @@index([createdAt])
}

//////////////////////////////////////////////////
// CLIENTE
//////////////////////////////////////////////////

model Cliente {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // TIPO
  //////////////////////////////////////////////////

  tipoCliente TipoCliente @default(PESSOA_FISICA)

  //////////////////////////////////////////////////
  // DADOS
  //////////////////////////////////////////////////

  nome String

  //////////////////////////////////////////////////
  // PESSOA FÍSICA
  //////////////////////////////////////////////////

  cpf String? @unique

  //////////////////////////////////////////////////
  // PESSOA JURÍDICA
  //////////////////////////////////////////////////

  cnpj String? @unique

  razaoSocial String?

  inscricaoEstadual String?

  nomeFantasia String?

  proprietarioNome String?

  telefone String?

  email String?

  endereco String?

  bairro String?

  cep String?

  cidade String?

  estado String?

  observacoes String?

  descontoPercentual Float @default(0)

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // RELAÇÕES
  //////////////////////////////////////////////////

  compras Compra[]

  vendas Venda[]

  transacoes Transacao[]

  pagamentos PagamentoTransacao[]

  alertas AlertaSistema[]

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([nome])
  @@index([telefone])
  @@index([createdAt])
  @@index([tipoCliente])
  @@index([cpf])
  @@index([cnpj])
  @@index([nomeFantasia])
  @@index([razaoSocial])
  @@index([inscricaoEstadual])
  @@index([proprietarioNome])
  @@index([cidade])
  @@index([estado])
  @@index([bairro])
}

//////////////////////////////////////////////////
// COMPRA (ENTRADA)
//////////////////////////////////////////////////

model Compra {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // RELAÇÃO
  //////////////////////////////////////////////////

  clienteId String?

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // SNAPSHOT PRODUTOR
  //////////////////////////////////////////////////

  clienteNomeSnapshot String

  clienteTelefoneSnapshot String?

  clienteDocumentoSnapshot String?

  clienteEnderecoSnapshot String?

  //////////////////////////////////////////////////
  // IDENTIFICAÇÃO
  //////////////////////////////////////////////////

  safra String?

  dataCompra DateTime

  modeloCaminhao ModeloCaminhao

  placa String

  numeroFolha String?

  //////////////////////////////////////////////////
  // PESAGEM
  //////////////////////////////////////////////////

  kgBruto Float

  quantidadeFrutas Int

  mediaFruta Float

  //////////////////////////////////////////////////
  // DESCONTO
  //////////////////////////////////////////////////

  tipoDesconto TipoDescontoCompra

  descontoPercentualAplicado Float?

  descontoKgManual Float?

  descontoKgCalculado Float

  //////////////////////////////////////////////////
  // COMPATIBILIDADE
  //////////////////////////////////////////////////

  kgDescontado Float

  kgLiquido Float

  //////////////////////////////////////////////////
  // FINANCEIRO
  //////////////////////////////////////////////////

  precoKg Decimal @db.Decimal(10, 2)

  totalBruto Decimal @db.Decimal(12, 2)

  despesas Decimal @default(0) @db.Decimal(12, 2)

  valorTotal Decimal @db.Decimal(12, 2)

  //////////////////////////////////////////////////
  // LEGADO
  //////////////////////////////////////////////////

  caminhoes Int @default(1)

  descontoKg Float?

  descontoValor Float?

  //////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////

  status StatusCompra @default(FECHADA)

  canceladoEm DateTime?

  motivoCancelamento String?

  //////////////////////////////////////////////////
  // OBSERVAÇÕES
  //////////////////////////////////////////////////

  observacoes String?

  //////////////////////////////////////////////////
  // AUDITORIA
  //////////////////////////////////////////////////

  usuarioResponsavelId String?

  usuarioResponsavelNome String?

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // RELAÇÕES
  //////////////////////////////////////////////////

  transacoes Transacao[]

  //////////////////////////////////////////////////
  // NOVO DOMÍNIO COMPRAS
  //////////////////////////////////////////////////

  fornecedorId String?

  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  fazendaFornecedorId String?

  fazendaFornecedor FazendaFornecedor? @relation(fields: [fazendaFornecedorId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([clienteId])
  @@index([dataCompra])
  @@index([modeloCaminhao])
  @@index([placa])
  @@index([numeroFolha])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt, status])
  @@index([fornecedorId])
  @@index([fazendaFornecedorId])
  @@index([usuarioResponsavelId])
}

//////////////////////////////////////////////////
// VENDA (ROMANEIO / SAÍDA)
//////////////////////////////////////////////////

model Venda {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // RELAÇÃO
  //////////////////////////////////////////////////

  clienteId String

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  //////////////////////////////////////////////////
  // SNAPSHOT CLIENTE
  //////////////////////////////////////////////////

  clienteNomeSnapshot String

  clienteTelefoneSnapshot String?

  clienteDocumentoSnapshot String?

  clienteEnderecoSnapshot String?

  //////////////////////////////////////////////////
  // IDENTIFICAÇÃO
  //////////////////////////////////////////////////

  dataVenda DateTime @default(now())

  numeroPedido String? @unique

  produto String @default("Melancia")

  qualidade String?

  cidade String?

  telefone String?

  localEntrega String?

  //////////////////////////////////////////////////
  // ROMANEIO
  //////////////////////////////////////////////////

  numeroRomaneio String? @unique

  destino String?

  tipoFrete TipoFreteVenda?

  //////////////////////////////////////////////////
  // CAMINHÃO
  //////////////////////////////////////////////////

  placa String?

  modeloCaminhao ModeloCaminhao?

  //////////////////////////////////////////////////
  // MOTORISTA
  //////////////////////////////////////////////////

  motoristaNome String?

  motoristaTelefone String?

  motoristaCpf String?

  //////////////////////////////////////////////////
  // PESAGEM
  //////////////////////////////////////////////////

  // ==============================================
  // ESTOQUE REAL
  // ==============================================

  pesoBruto Float

  // ==============================================
  // DESCONTO OPERACIONAL / COMERCIAL
  // ==============================================

  pesoDesconto Float @default(0)

  // ==============================================
  // FECHAMENTO FINANCEIRO
  // ==============================================

  pesoLiquido Float

  // ==============================================
  // COMPATIBILIDADE
  // ==============================================

  quantidadeKg Float

  // ==============================================
  // FRUTAS
  // ==============================================

  quantidadeFrutas Int?

  mediaFruta Float?

  //////////////////////////////////////////////////
  // FINANCEIRO
  //////////////////////////////////////////////////

  // ==============================================
  // PREÇO MELANCIA
  // ==============================================

  precoMelancia Decimal @db.Decimal(10, 2)

  observacaoPreco String?

  // ==============================================
  // COMPATIBILIDADE LEGADA
  // ==============================================

  precoMercado Decimal? @db.Decimal(10, 2)

  precoFrete Decimal? @db.Decimal(10, 2)

  valorPorKg Decimal @db.Decimal(10, 2)

  precoFinal Decimal? @db.Decimal(10, 2)

  descontoFruta Decimal? @db.Decimal(10, 2)

  descontoValor Decimal? @db.Decimal(10, 2)

  icmsOutros Decimal? @db.Decimal(10, 2)

  // ==============================================
  // FECHAMENTO
  // ==============================================

  valorMelancia Decimal @db.Decimal(12, 2)

  freteTotal Decimal? @db.Decimal(12, 2)

  valorTotal Decimal @db.Decimal(12, 2)

  //////////////////////////////////////////////////
  // PAGAMENTO
  //////////////////////////////////////////////////

  statusPagamento StatusPagamento @default(PENDENTE)

  //////////////////////////////////////////////////
  // STATUS OPERACIONAL
  //////////////////////////////////////////////////

  status StatusVenda @default(ABERTA)

  //////////////////////////////////////////////////
  // CANCELAMENTO
  //////////////////////////////////////////////////

  canceladoEm DateTime?

  motivoCancelamento String?

  //////////////////////////////////////////////////
  // PDF
  //////////////////////////////////////////////////

  pdfGeradoEm DateTime?

  //////////////////////////////////////////////////
  // OBSERVAÇÕES
  //////////////////////////////////////////////////

  observacoes String?

  //////////////////////////////////////////////////
  // AUDITORIA
  //////////////////////////////////////////////////

  usuarioResponsavelId String?

  usuarioResponsavelNome String?

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // RELAÇÕES
  //////////////////////////////////////////////////

  transacoes Transacao[]

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([clienteId])
  @@index([numeroPedido])
  @@index([numeroRomaneio])
  @@index([dataVenda])
  @@index([produto])
  @@index([qualidade])
  @@index([cidade])
  @@index([placa])
  @@index([modeloCaminhao])
  @@index([statusPagamento])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt, statusPagamento])
  @@index([createdAt, status])
  @@index([dataVenda, status])
  @@index([dataVenda, statusPagamento])
  @@index([usuarioResponsavelId])
}

//////////////////////////////////////////////////
// FINANCEIRO
//////////////////////////////////////////////////

enum FormaPagamento {
  PIX
  DINHEIRO
  CHEQUE
  TRANSFERENCIA
  BOLETO
}

enum StatusFinanceiro {
  PENDENTE
  PARCIAL
  PAGO
  ATRASADO
  CANCELADO
}

enum TipoAlertaFornecedor {
  LIMITE_PROXIMO
  LIMITE_ULTRAPASSADO
  VENCIMENTO_PROXIMO
  VENCIDO
}

//////////////////////////////////////////////////
// ALERTAS SISTEMA
//////////////////////////////////////////////////

enum CategoriaAlerta {
  LIMITE_FINANCEIRO
  VENCIMENTO
  INADIMPLENCIA
  FINANCEIRO
  OPERACIONAL
}

enum SeveridadeAlerta {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

//////////////////////////////////////////////////
// FINANCEIRO
//////////////////////////////////////////////////

model Transacao {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // CLIENTE
  //////////////////////////////////////////////////

  clienteId String?

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // FORNECEDOR
  //////////////////////////////////////////////////

  fornecedorId String?

  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // FINANCEIRO
  //////////////////////////////////////////////////

  tipo TipoTransacao

  valor Decimal @db.Decimal(12, 2)

  //////////////////////////////////////////////////
  // PAGAMENTO
  //////////////////////////////////////////////////

  formaPagamento FormaPagamento?

  statusFinanceiro StatusFinanceiro @default(PENDENTE)

  //////////////////////////////////////////////////
  // VALORES
  //////////////////////////////////////////////////

  valorPago Decimal? @db.Decimal(12, 2)

  valorRestante Decimal? @db.Decimal(12, 2)

  //////////////////////////////////////////////////
  // DATAS
  //////////////////////////////////////////////////

  vencimento DateTime?

  pagoEm DateTime?

  //////////////////////////////////////////////////
  // REFERÊNCIA
  //////////////////////////////////////////////////

  referencia String?

  descricao String?

  observacoes String?

  //////////////////////////////////////////////////
  // RELAÇÃO COMPRA
  //////////////////////////////////////////////////

  compraId String?

  compra Compra? @relation(fields: [compraId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // RELAÇÃO VENDA
  //////////////////////////////////////////////////

  vendaId String?

  venda Venda? @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // PAGAMENTOS GRANULARES
  //////////////////////////////////////////////////

  pagamentos PagamentoTransacao[]

  //////////////////////////////////////////////////
  // DESPESAS
  //////////////////////////////////////////////////

  despesasCompra DespesaCompra[]

  despesasOperacionais DespesaOperacional[]

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([clienteId])
  @@index([tipo])
  @@index([formaPagamento])
  @@index([statusFinanceiro])
  @@index([createdAt])
  @@index([vencimento])
  @@index([pagoEm])
  @@index([compraId])
  @@index([vendaId])
  @@index([referencia])
  @@index([createdAt, tipo])
  @@index([clienteId, tipo])
  @@index([clienteId, createdAt])
  @@index([statusFinanceiro, vencimento])
  @@index([formaPagamento, createdAt])
  @@index([fornecedorId])
}

//////////////////////////////////////////////////
// HISTÓRICO PAGAMENTOS / BAIXAS
//////////////////////////////////////////////////

model PagamentoTransacao {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // RELAÇÃO TRANSAÇÃO
  //////////////////////////////////////////////////

  transacaoId String

  transacao Transacao @relation(fields: [transacaoId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////
  // CLIENTE
  //////////////////////////////////////////////////

  clienteId String?

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // FORNECEDOR
  //////////////////////////////////////////////////

  fornecedorId String?

  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // VALORES
  //////////////////////////////////////////////////

  valor Decimal @db.Decimal(12, 2)

  //////////////////////////////////////////////////
  // RESTANTE APÓS BAIXA
  //////////////////////////////////////////////////

  valorRestanteApos Decimal @db.Decimal(12, 2)

  //////////////////////////////////////////////////
  // PAGAMENTO
  //////////////////////////////////////////////////

  formaPagamento FormaPagamento

  //////////////////////////////////////////////////
  // DATAS
  //////////////////////////////////////////////////

  pagoEm DateTime @default(now())

  vencimento DateTime?

  //////////////////////////////////////////////////
  // OBSERVAÇÕES
  //////////////////////////////////////////////////

  observacoes String?

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([transacaoId])
  @@index([clienteId])
  @@index([formaPagamento])
  @@index([pagoEm])
  @@index([createdAt])
  @@index([clienteId, createdAt])
  @@index([transacaoId, createdAt])
  @@index([fornecedorId])
}

//////////////////////////////////////////////////
// FORNECEDORES
//////////////////////////////////////////////////

model Fornecedor {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // DADOS
  //////////////////////////////////////////////////

  nome String

  sobrenome String?

  telefone String?

  estado String?

  observacoes String?

  //////////////////////////////////////////////////
  // LIMITES
  //////////////////////////////////////////////////

  limiteFinanceiroValor Decimal? @db.Decimal(12, 2)

  limiteFinanceiroDias Int?

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // RELAÇÕES
  //////////////////////////////////////////////////

  fazendas FazendaFornecedor[]

  compras Compra[]

  transacoes Transacao[]

  pagamentos PagamentoTransacao[]

  alertas AlertaFornecedor[]

  alertasSistema AlertaSistema[]

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([nome])
  @@index([telefone])
  @@index([estado])
  @@index([createdAt])
}

//////////////////////////////////////////////////
// FAZENDAS DO FORNECEDOR
//////////////////////////////////////////////////

model FazendaFornecedor {
  id String @id @default(uuid())

  fornecedorId String

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////
  // DADOS
  //////////////////////////////////////////////////

  nome String

  cidade String?

  estado String?

  observacoes String?

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // RELAÇÕES
  //////////////////////////////////////////////////

  compras Compra[]

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([fornecedorId])
  @@index([nome])
  @@index([estado])
}

//////////////////////////////////////////////////
// DESPESAS DE COMPRAS
//////////////////////////////////////////////////

model DespesaCompra {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // DADOS
  //////////////////////////////////////////////////

  data DateTime

  atividade String

  gasto Decimal @db.Decimal(12, 2)

  observacoes String?

  //////////////////////////////////////////////////
  // FINANCEIRO
  //////////////////////////////////////////////////

  transacaoId String?

  transacao Transacao? @relation(fields: [transacaoId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([data])
  @@index([atividade])
  @@index([transacaoId])
  @@index([createdAt])
}

//////////////////////////////////////////////////
// DESPESAS OPERACIONAIS
//////////////////////////////////////////////////

model DespesaOperacional {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // DADOS
  //////////////////////////////////////////////////

  data DateTime

  atividade String

  valor Decimal @db.Decimal(12, 2)

  observacoes String?

  //////////////////////////////////////////////////
  // FINANCEIRO
  //////////////////////////////////////////////////

  transacaoId String?

  transacao Transacao? @relation(fields: [transacaoId], references: [id], onDelete: SetNull)

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([data])
  @@index([atividade])
  @@index([transacaoId])
  @@index([createdAt])
}

//////////////////////////////////////////////////
// ALERTAS FORNECEDOR
//////////////////////////////////////////////////

model AlertaFornecedor {
  id String @id @default(uuid())

  fornecedorId String

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////
  // ALERTA
  //////////////////////////////////////////////////

  tipo TipoAlertaFornecedor

  mensagem String

  resolvido Boolean @default(false)

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([fornecedorId])
  @@index([tipo])
  @@index([resolvido])
  @@index([createdAt])
}

//////////////////////////////////////////////////
// ALERTAS SISTEMA
//////////////////////////////////////////////////

model AlertaSistema {
  id String @id @default(uuid())

  //////////////////////////////////////////////////
  // TIPO
  //////////////////////////////////////////////////

  categoria CategoriaAlerta

  severidade SeveridadeAlerta

  //////////////////////////////////////////////////
  // RELAÇÕES
  //////////////////////////////////////////////////

  clienteId String?

  cliente Cliente? @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  fornecedorId String?

  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)

  //////////////////////////////////////////////////
  // CONTEÚDO
  //////////////////////////////////////////////////

  titulo String

  mensagem String

  //////////////////////////////////////////////////
  // STATUS
  //////////////////////////////////////////////////

  lido Boolean @default(false)

  resolvido Boolean @default(false)

  //////////////////////////////////////////////////
  // CONTROLE
  //////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //////////////////////////////////////////////////
  // ÍNDICES
  //////////////////////////////////////////////////

  @@index([categoria])
  @@index([severidade])
  @@index([lido])
  @@index([resolvido])
  @@index([createdAt])
}
